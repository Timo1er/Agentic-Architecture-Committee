# Application Configuration
APP_NAME="Architecture Review Board"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security & JWT Auth
SECRET_KEY="super-secret-arb-key-change-in-production-min-32-chars-key!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY="32_byte_base64_encoded_encryption_key_here_arb_safe="

# Default Admin Credentials
ADMIN_EMAIL="admin@arb.local"
ADMIN_PASSWORD="AdminPassword123!"

# Relational Database (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./arb_database.db"
# For PostgreSQL in Docker:
# DATABASE_URL="postgresql://arb_user:arb_password@postgres:5432/arb_db"

# Vector Database (Qdrant / pgvector)
VECTOR_DB_TYPE="qdrant" # or "pgvector"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION="arb_historical_feedback"

# Default LLM Provider Settings (can also be configured via Web Admin UI)
DEFAULT_LLM_PROVIDER="google" # Options: google, anthropic, openai, mistral, aws
DEFAULT_MODEL_NAME="gemini-1.5-pro"

# Provider API Keys (Can be set here or injected via Admin UI)
GOOGLE_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BEDROCK_MODEL_ID="anthropic.claude-3-sonnet-20240229-v1:0"

# SSO / Okta Integration Configuration
SSO_ENABLED=false
SSO_PROVIDER="okta" # okta, generic_saml, oidc
OKTA_CLIENT_ID=""
OKTA_CLIENT_SECRET=""
OKTA_DOMAIN=""
OKTA_REDIRECT_URI="http://localhost:8000/api/auth/sso/callback"
